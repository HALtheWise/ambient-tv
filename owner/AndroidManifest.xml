<?xml version="1.0" encoding="utf-8"?>
<!-- testOnly so `dpm remove-active-admin` can take device ownership back without a factory reset. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="bot.tvowner"
    android:versionCode="1"
    android:versionName="1">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />

    <!-- Held by our other apps (same signing key), e.g. the launcher's screen-off timer. -->
    <permission android:name="bot.tvowner.permission.CONTROL" android:protectionLevel="signature" />

    <application android:label="@string/app_name" android:testOnly="true" android:allowBackup="false">

        <receiver android:name=".Admin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Command channel. DUMP is held by the adb shell but not by ordinary apps. -->
        <receiver android:name=".Cmd"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="bot.tvowner.CMD" />
            </intent-filter>
        </receiver>

        <receiver android:name=".Sleep"
            android:exported="true"
            android:permission="bot.tvowner.permission.CONTROL">
            <intent-filter>
                <action android:name="bot.tvowner.SLEEP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
